38489>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38489>>>                Case Break
38490>>>
38490>>>            Case Else // must be nfUndefined
38490>>>
38490>>>        Case End
38490>>>
38490>>>        Send SetActionButtons
