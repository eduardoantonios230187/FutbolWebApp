38448>>>    Procedure SetActionButtons
38451>>>        tWebNavigateData NavigateData
38451>>>        tWebNavigateData NavigateData
38451>>>        Boolean bHasRecord
38451>>>        Handle hoDD
38451>>>
38451>>>        Get Server to hoDD
38452>>>        Get GetNavigateData to NavigateData
38453>>>        Get HasRecord of hoDD to bHasRecord
38454>>>
38454>>>        // let's hide all buttons and then Show the ones we want
38454>>>        WebSet pbRender of oEditBtn to False
38455>>>        WebSet pbRender of oSaveBtn to False
38456>>>        WebSet pbRender of oCancelChangesBtn to False
38457>>>        WebSet pbRender of oDeleteBtn to False
38458>>>
38458>>>        If (NavigateData.bReadOnly) Begin
38460>>>            WebSet pbRender of oEditBtn to True
38461>>>        End
38461>>>>
38461>>>        Else Begin
38462>>>            WebSet pbRender of oSaveBtn to True
38463>>>            WebSet pbRender of oCancelChangesBtn to True
38464>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38465>>>        End
38465>>>>
38465>>>    End_Procedure
